# ===================================================
# CropNex 2.0 Environment Configuration
# ===================================================

# Database Connection (MongoDB Atlas or Local MongoDB)
# For local: mongodb://127.0.0.1:27017/cropnex
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cropnex?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cropnex

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cropnex_secure_jwt_secret_token_at_sih_2026_dev

# Google OAuth Credentials (From Google Cloud Console: console.cloud.google.com)
# 1. Create a project in Google Cloud Console
# 2. Go to APIs & Services > Credentials
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
